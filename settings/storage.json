{
    "backend": "http://storage:8080",
    "endpoints": [
    {
      "methods": [ "GET" ],
      "endpoint": "v2/pools"
    },
    {
      "methods": [ "GET", "POST" ],
      "endpoint": "v2/accounts"
    },
    {
      "methods": [ "GET", "PUT", "DELETE" ],
      "endpoint": "v2/accounts/{account}"
    },
    {
      "methods": [ "GET" ],
      "endpoint": "v2/accounts/{account}/usage"
    },
    {
      "methods": [ "GET" ],
      "endpoint": "v2/iscsi/limits"
    },
    {
      "methods": [ "GET" ],
      "endpoint": "v2/s3/limits"
    },
    {
      "methods": [ "GET", "POST" ],
      "endpoint": "v2/iscsi/quotas"
    },
    {
      "methods": [ "PUT", "DELETE" ],
      "endpoint": "v2/iscsi/quotas/{quota_id}"
    },
    {
      "methods": [ "GET", "POST" ],
      "endpoint": "v2/s3/quotas"
    },
    {
      "methods": [ "PUT", "DELETE" ],
      "endpoint": "v2/s3/quotas/{quota_id}"
    },
    {
      "methods": [ "GET", "POST" ],
      "endpoint": "v2/s3/users"
    },
    {
      "methods": [ "GET", "PUT", "DELETE" ],
      "endpoint": "v2/s3/users/{id}"
    },
    {
      "methods": [ "POST" ],
      "endpoint": "v2/s3/users/{id}/keys"
    },
    {
      "methods": [ "GET", "POST" ],
      "endpoint": "v2/s3/buckets"
    },
    {
      "methods": [ "PUT", "DELETE" ],
      "endpoint": "v2/s3/buckets/{name}/{bucket}"
    },
    {
      "methods": [ "GET", "POST" ],
      "endpoint": "v2/iscsi/clients"
    },
    {
      "methods": [ "PUT", "DELETE" ],
      "endpoint": "v2/iscsi/clients/{client_id}"
    },
    {
      "methods": [ "GET", "POST" ],
      "endpoint": "v2/iscsi/clusters"
    },
    {
      "methods": [ "GET", "DELETE" ],
      "endpoint": "v2/iscsi/clusters/{cluster_id}"
    },
    {
      "methods": [ "POST" ],
      "endpoint": "v2/iscsi/gateways"
    },
    {
      "methods": [ "DELETE" ],
      "endpoint": "v2/iscsi/gateways/{gateway_id}"
    },
    {
      "methods": [ "POST" ],
      "endpoint": "v2/iscsi/targets"
    },
    {
      "methods": [ "DELETE" ],
      "endpoint": "v2/iscsi/targets/{target_id}"
    },
    {
      "methods": [ "GET", "POST" ],
      "endpoint": "v2/iscsi/disks"
    },
    {
      "methods": [ "PUT", "DELETE" ],
      "endpoint": "v2/iscsi/disks/{id}"
    },
    {
      "methods": [ "GET", "POST" ],
      "endpoint": "v2/iscsi/snapshots"
    },
    {
      "methods": [ "GET", "PUT", "DELETE" ],
      "endpoint": "v2/iscsi/snapshots/{snapshot_id}"
    },
    {
      "methods": [ "POST" ],
      "endpoint": "v2/iscsi/snapshots/{snapshot_name}/new_disk"
    },
    {
      "methods": [ "POST" ],
      "endpoint": "v2/iscsi/snapshots/{snapshot_name}/rollback"
    },
    {
      "methods": [ "GET", "POST" ],
      "endpoint": "v2/iscsi/clients/{client_id}/disks"
    },
    {
      "methods": [ "DELETE" ],
      "endpoint": "v2/iscsi/clients/{client_id}/disks/{id}"
    }
    ]
}
